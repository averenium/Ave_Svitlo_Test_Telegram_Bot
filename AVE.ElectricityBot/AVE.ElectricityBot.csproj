<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2662614a-d532-42ee-8227-dcb07948d795</UserSecretsId>
    
    <!-- Docker/Container Support -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerImageTag>latest</ContainerImageTag>
    <ContainerPort>8080</ContainerPort>
    <ContainerRepository>evgenles/ave-svitlo-test-app</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <ContainerEnvironmentVariable Include="TZ" Value="Europe/Kyiv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Cosmos" Version="9.0.10" />
    <PackageReference Include="Telegram.Bot" Version="22.7.5" />
    
    <!-- Prometheus та OpenTelemetry для метрик -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.10.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.0.0-beta.12" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AVE.ElectricityBot.YasnoApi\AVE.ElectricityBot.YasnoApi.csproj" />
    <ProjectReference Include="..\AVE.ElectricityBot.TelegramScraper\AVE.ElectricityBot.TelegramScraper.csproj" />
  </ItemGroup>

</Project>
