<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2662614a-d532-42ee-8227-dcb07948d795</UserSecretsId>
    
    <!-- Docker/Container Support -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerImageTag>2.5</ContainerImageTag>
    <ContainerPort>8080</ContainerPort>
    <ContainerRepository>evgenles/ave-svitlo-test-app</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <ContainerEnvironmentVariable Include="TZ" Value="Europe/Kyiv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="EntityFrameworkCore.ClickHouse" Version="3.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Cosmos" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Telegram.Bot" Version="22.10.4" />
    
    <!-- Prometheus та OpenTelemetry для метрик -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.2-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AVE.ElectricityBot.YasnoApi\AVE.ElectricityBot.YasnoApi.csproj" />
    <ProjectReference Include="..\AVE.ElectricityBot.TelegramScraper\AVE.ElectricityBot.TelegramScraper.csproj" />
    <ProjectReference Include="..\AVE.ElectricityBot.Data\AVE.ElectricityBot.Data.csproj" />
  </ItemGroup>

</Project>
